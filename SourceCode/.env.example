# Tham khảo cấu hình; GatewayServer không tự đọc file này. Set thành environment variables.
AI_MODE=MOCK
GATEWAY_PORT=8088
GATEWAY_URL=http://localhost:8088
GATEWAY_CALL_TOKEN=replace-with-random-secret
GATEWAY_INVENTORY_TOKEN=replace-with-a-different-random-secret

# LIVE only; chỉ cấu hình trên máy gateway.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GOOGLE_APPLICATION_CREDENTIALS=C:/secure-path/service-account.json
TTS_VOICE=vi-VN-Neural2-A
TTS_RATE=0.92
TTS_VOLUME_GAIN_DB=0
TTS_CACHE_DIR=data/tts-cache
