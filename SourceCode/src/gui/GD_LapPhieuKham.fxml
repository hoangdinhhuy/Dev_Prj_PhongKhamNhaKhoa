<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_LapPhieuKham_Controller" prefWidth="1000" prefHeight="640">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="header">
            <Label text="Lập phiếu khám" styleClass="page-title"/>
            <Label text="Chọn một phòng trống để xem danh sách lượt và bấm Lập phiếu khám. Phòng tắt nhận bệnh do Phụ tá đặt sẽ bị khóa."
                   styleClass="hint-text"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="center-pane">
                <ComboBox fx:id="cbb_loc" prefWidth="240"/>
                <TextField fx:id="txt_timPhong" prefWidth="220" promptText="Nhập mã/tên phòng cần tìm"
                           onAction="#timPhong"/>
                <Button text="Tìm phòng" onAction="#timPhong"/>
                <Button text="Tất cả" onAction="#tatCa"/>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <content>
                    <FlowPane fx:id="paneTiles" hgap="14" vgap="14"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
