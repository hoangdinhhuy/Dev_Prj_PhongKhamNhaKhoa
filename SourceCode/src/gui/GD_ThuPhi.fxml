<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_ThuPhi_Controller" prefWidth="1000" prefHeight="640">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <Label text="Thu tiền phí khám ban đầu" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="16" styleClass="page-content" fillHeight="true">
            <VBox styleClass="card" spacing="10" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <GridPane hgap="10" vgap="10" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" prefWidth="160"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="260"/>
                        <ColumnConstraints minWidth="120" prefWidth="130"/>
                    </columnConstraints>
                    <Label text="Mã BN / SĐT" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txt_timBN" prefWidth="280" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               promptText="BN... hoặc 090..."/>
                    <Button fx:id="btn_tim" text="Tìm" onAction="#tim" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Label text="Bệnh nhân" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lb_thongTinBN" text="(chưa chọn)" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           GridPane.columnSpan="2" maxWidth="Infinity" style="-fx-font-weight: bold;"/>
                    <Label text="Mức phí khám" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lb_mucPhi" text="(chọn bệnh nhân để xem phí)" GridPane.rowIndex="2" GridPane.columnIndex="1"
                           GridPane.columnSpan="2" style="-fx-font-weight: bold;"/>
                    <Label text="Hình thức" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbb_hinhThuc" prefWidth="200" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Tiền khách đưa" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txt_tienKhachDua" prefWidth="280" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="Tiền thừa" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="lb_tienThua" text="" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="3">
                        <Button fx:id="btn_thuPhi" text="Thu phí" onAction="#thuPhi" defaultButton="true"/>
                        <Button fx:id="btn_xemHoaDon" text="Xem/In hóa đơn" onAction="#xemHoaDon" disable="true"/>
                        <Label fx:id="lb_hoaDon" text="" styleClass="hint-text"/>
                    </HBox>
                </GridPane>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <VBox fx:id="khungHoaDon" spacing="8" visible="false" managed="false">
            <ScrollPane fx:id="scrollHoaDon" fitToWidth="true" prefHeight="360" pannable="true">
                <content>
                    <VBox fx:id="noiDungHoaDon" spacing="6" style="-fx-background-color: white; -fx-padding: 12;"/>
                </content>
            </ScrollPane>
            <HBox spacing="10">
                <Button text="Lưu PDF" onAction="#luuHoaDonPdf" styleClass="print-action-btn"/>
                <Button text="In hóa đơn" onAction="#inHoaDon" styleClass="print-action-btn"/>
                <Button text="Đóng" onAction="#dongHoaDon"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
