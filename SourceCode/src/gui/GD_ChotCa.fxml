<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_ChotCa_Controller" prefWidth="1020" prefHeight="660">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <Label text="Chốt ca thu ngân" styleClass="page-title"/>
            <Label text="Mở ca → thu trong ca → chốt ca (xác nhận bàn giao) → nhân viên sau nhận ca"
                   styleClass="hint-text"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="center-pane">
            <!-- ===== TRANG THAI CA ===== -->
            <HBox spacing="14" alignment="CENTER_LEFT" styleClass="card">
                <VBox spacing="4">
                    <Label text="CA HIỆN TẠI" styleClass="stat-label"/>
                    <Label fx:id="lb_maCa" text="—" styleClass="stat-value"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="THU NGÂN" styleClass="stat-label"/>
                    <Label fx:id="lb_thuNgan" text="—" styleClass="stat-value"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="MỞ LÚC" styleClass="stat-label"/>
                    <Label fx:id="lb_moLuc" text="—" styleClass="stat-value"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="TRẠNG THÁI" styleClass="stat-label"/>
                    <Label fx:id="lb_trangThaiCa" text="—" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <!-- ===== BANG KE TRONG CA ===== -->
            <VBox spacing="6" styleClass="card" VBox.vgrow="ALWAYS">
                <Label fx:id="lb_bangKeTieuDe" text="BẢNG KÊ THU TRONG CA" styleClass="card-title"/>
                <TableView fx:id="tableBangKe" prefHeight="220" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="cl_bkHD" text="Hóa đơn" prefWidth="130"/>
                        <TableColumn fx:id="cl_bkGio" text="Giờ thu" prefWidth="70"/>
                        <TableColumn fx:id="cl_bkBN" text="Bệnh nhân" prefWidth="170"/>
                        <TableColumn fx:id="cl_bkLoai" text="Loại" prefWidth="140"/>
                        <TableColumn fx:id="cl_bkHT" text="Hình thức" prefWidth="110"/>
                        <TableColumn fx:id="cl_bkTien" text="Tiền" prefWidth="105"/>
                    </columns>
                </TableView>
                <HBox spacing="24" alignment="CENTER_LEFT">
                    <Label fx:id="lb_soHD" text="Số hóa đơn: 0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lb_tongCa" text="DOANH THU CA (dịch vụ): 0 ₫"
                           style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #1B7A3D;"/>
                    <Label fx:id="lb_phiHo" text="Phí khám thu hộ: 0 ₫" styleClass="hint-text"/>
                </HBox>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btn_moCa" text="NHẬN CA (mở ca làm việc)" onAction="#moCa"
                        styleClass="btn-primary"/>
                <Button fx:id="btn_chotCa" text="CHỐT CA — XÁC NHẬN BÀN GIAO" onAction="#chotCa"/>
                <Button fx:id="btn_luuBangKe" text="Lưu PDF bảng kê ca" onAction="#luuBangKe"
                        styleClass="print-action-btn"/>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <VBox spacing="6" styleClass="center-pane">
            <Label text="LỊCH SỬ CÁ ĐÃ CHỐT" styleClass="card-title"/>
            <TableView fx:id="table_lichSu" prefHeight="160">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cl_lsCa" text="Mã ca" prefWidth="90"/>
                    <TableColumn fx:id="cl_lsNV" text="Thu ngân mở ca" prefWidth="190"/>
                    <TableColumn fx:id="cl_lsMo" text="Mở lúc" prefWidth="130"/>
                    <TableColumn fx:id="cl_lsChot" text="Chốt lúc" prefWidth="130"/>
                    <TableColumn fx:id="cl_lsDV" text="Doanh thu dịch vụ" prefWidth="140"/>
                    <TableColumn fx:id="cl_lsHo" text="Phí thu hộ" prefWidth="120"/>
                    <TableColumn fx:id="cl_lsTT" text="Trạng thái" prefWidth="100"/>
                </columns>
            </TableView>
            <Label text="Sau khi chốt ca, thu ngân tiếp theo bấm NHẬN CA để bắt đầu ca mới." styleClass="hint-text"/>
        </VBox>
    </bottom>
</BorderPane>
