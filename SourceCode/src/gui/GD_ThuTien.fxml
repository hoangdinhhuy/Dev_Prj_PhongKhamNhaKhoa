<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_ThuTien_Controller" prefWidth="1020" prefHeight="660">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <Label text="Thu tiền (lễ tân kiêm thu ngân)" styleClass="page-title"/>
            <Label text="Phí khám đầu lượt + dịch vụ cuối lượt + bảng kê chốt ca — gộp một nơi" styleClass="hint-text"/>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab text="1 · Phí khám (đầu lượt)">
                <VBox spacing="10" styleClass="center-pane">
                    <GridPane hgap="10" vgap="10" maxWidth="Infinity">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170" prefWidth="185"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
                            <ColumnConstraints minWidth="110" prefWidth="120"/>
                        </columnConstraints>
                        <Label text="Khách cũ (SĐT/CCCD/mã BN)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txt_timBN" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   promptText="BN... hoặc 090... hoặc 12 số CCCD"/>
                        <Button fx:id="btn_tim" text="Tìm" onAction="#tim" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label text="Bệnh nhân" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lb_thongTinBN" text="(chưa chọn)" GridPane.rowIndex="1" GridPane.columnIndex="1"
                               GridPane.columnSpan="2" style="-fx-font-weight: bold;"/>
                        <Label text="Mức phí khám" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lb_mucPhi" text="(chọn bệnh nhân để xem phí)" GridPane.rowIndex="2"
                               GridPane.columnIndex="1" GridPane.columnSpan="2" style="-fx-font-weight: bold;"/>
                        <Label text="Hình thức" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbb_hinhThucPhi" prefWidth="200" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Tiền khách đưa" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txt_tienKhachDua" prefWidth="280" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label text="Tiền thừa" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="lb_tienThuaPhi" text="" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="3" alignment="CENTER_LEFT">
                            <Button fx:id="btn_thuPhi" text="Thu phí khám" onAction="#thuPhi" styleClass="btn-primary"/>
                            <Button fx:id="btn_xemHoaDon" text="Xem/In hóa đơn" onAction="#xemHoaDon" disable="true"/>
                            <Button fx:id="btn_lapPhieuNgay" text="Lập phiếu khám ngay →" onAction="#sangLapPhieu"
                                    visible="false" managed="false" styleClass="btn-primary"/>
                            <Label fx:id="lb_hoaDonPhi" text="" styleClass="hint-text"/>
                        </HBox>
                    </GridPane>
                    <VBox fx:id="khungHoaDonPhi" spacing="8" visible="false" managed="false">
                        <ScrollPane fx:id="scrollHoaDonPhi" fitToWidth="true" prefHeight="330" pannable="true">
                            <content>
                                <VBox fx:id="noiDungHoaDonPhi" spacing="6" style="-fx-background-color: white; -fx-padding: 12;"/>
                            </content>
                        </ScrollPane>
                        <HBox spacing="10">
                            <Button text="Lưu PDF" onAction="#luuHoaDonPhi" styleClass="print-action-btn"/>
                            <Button text="In hóa đơn" onAction="#inHoaDonPhi" styleClass="print-action-btn"/>
                            <Button text="Đóng" onAction="#dongHoaDonPhi"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>
            <Tab text="2 · Dịch vụ cuối lượt (chốt lượt)">
                <HBox spacing="14" styleClass="center-pane" fillHeight="true">
                    <VBox spacing="8" prefWidth="430" maxWidth="430">
                        <Label text="Lượt khám đã HOAN_TAT — chờ thu" styleClass="card-title"/>
                        <TableView fx:id="table_phieu" prefHeight="420" VBox.vgrow="ALWAYS">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="cl_ma" text="Mã phiếu" prefWidth="140"/>
                                <TableColumn fx:id="cl_bn" text="Bệnh nhân" prefWidth="190"/>
                                <TableColumn fx:id="cl_ngay" text="Ngày khám" prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox fx:id="khungNoiDung" spacing="10" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <VBox styleClass="card" spacing="8" maxWidth="Infinity">
                            <Label text="CHI TIẾT LƯỢT KHÁM" styleClass="card-title"/>
                            <Label fx:id="lb_thongTin" text="(chưa chọn lượt khám)" style="-fx-font-weight: bold;"/>
                            <TableView fx:id="table_dichVu" prefHeight="170" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="cl_dv" text="Dịch vụ" prefWidth="240"/>
                                    <TableColumn fx:id="cl_gia" text="Đơn giá" prefWidth="130"/>
                                </columns>
                            </TableView>
                            <HBox spacing="26" alignment="CENTER_LEFT">
                                <Label text="TỔNG:" style="-fx-font-weight: bold;"/>
                                <Label fx:id="lb_tong" text="0 ₫" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                            </HBox>
                            <GridPane hgap="10" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="150" prefWidth="160"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                                </columnConstraints>
                                <Label text="Hình thức" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <ComboBox fx:id="cbb_hinhThucDV" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Tiền khách đưa" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txt_tienDuaDV" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="Tiền thừa" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label fx:id="lb_tienThuaDV" text="" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Button fx:id="btn_thanhToan" text="Thanh toán &amp; in hóa đơn" onAction="#thanhToan" styleClass="btn-primary"/>
                        </VBox>
                    </VBox>
                </HBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
