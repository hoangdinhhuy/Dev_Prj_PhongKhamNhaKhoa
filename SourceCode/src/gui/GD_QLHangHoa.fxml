<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_QLHangHoa_Controller" prefWidth="1050" prefHeight="650">
    <top>
        <VBox spacing="8" styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="Quản lý hàng hóa / Tồn kho dược phẩm &amp; vật tư" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lb_thongKeHangHoa" text="Chưa tìm kiếm (Danh sách đang để trống)" styleClass="hint-text"/>
            </HBox>
            <!-- Thanh tra cứu tồn kho (ẩn danh sách cho đến khi bấm Tìm kiếm) -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #F0F4F8; -fx-padding: 8 12; -fx-background-radius: 8;">
                <Label text="Tra cứu tồn kho:" style="-fx-font-weight: bold; -fx-text-fill: #173A5E;"/>
                <TextField fx:id="txt_timKiem" promptText="Nhập Tên hoặc Mã hàng hóa..." prefWidth="280"/>
                <Label text="Tình trạng:"/>
                <ComboBox fx:id="cbb_locTinhTrang" prefWidth="200"/>
                <Button fx:id="btn_timKiem" text="Tìm kiếm" onAction="#timKiem" styleClass="btn-primary" defaultButton="true"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="12" styleClass="center-pane" prefWidth="360">
            <Label text="THÔNG TIN HÀNG HÓA" styleClass="section-title"/>
            <GridPane hgap="8" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="110" prefWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Mã hàng hóa" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_maHang" editable="false" promptText="(Tự động cấp mã HHxxxx)" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Tên hàng hóa*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_ten" promptText="Ví dụ: Găng tay y tế" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Đơn vị tính*" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_donVi" promptText="Hộp, Cái, Vỉ..." GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Số lượng tồn*" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_soLuong" promptText="Số nguyên >= 0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Mức tồn tối thiểu*" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_mucToiThieu" promptText="Mức cảnh báo thiếu" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Tình trạng tồn" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_tinhTrangHienTai" editable="false" promptText="Tự động tính toán" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Lưới nút hành động: giải quyết triệt để lỗi co nút mất chữ -->
            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <Button fx:id="btn_them" text="Thêm mới" maxWidth="Infinity" onAction="#them" styleClass="btn-success" style="-fx-padding: 9 8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button fx:id="btn_capNhat" text="Cập nhật" maxWidth="Infinity" onAction="#capNhat" styleClass="btn-primary" style="-fx-padding: 9 8;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button fx:id="btn_lamMoi" text="Làm mới" maxWidth="Infinity" onAction="#lamMoi" style="-fx-padding: 9 8;" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="card" spacing="6">
                <Label text="NGUYÊN TẮC QUẢN LÝ TỒN KHO" style="-fx-font-weight: bold; -fx-text-fill: #1D5C8F;"/>
                <Label text="• Khi Số lượng tồn ≤ Mức tồn tối thiểu, hệ thống tự động gán nhãn [Cần bổ sung] cảnh báo màu đỏ." wrapText="true" styleClass="hint-text"/>
                <Label text="• Quản lý cần chủ động kiểm tra danh sách này để lên đơn nhập hàng kịp thời." wrapText="true" styleClass="hint-text"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="8" styleClass="center-pane">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="KẾT QUẢ TRA CỨU HÀNG HÓA &amp; TỒN KHO" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="* Dữ liệu ban đầu được ẩn. Vui lòng bấm Tìm kiếm để xem danh sách." style="-fx-font-style: italic; -fx-text-fill: #7A8CA3;"/>
            </HBox>

            <TableView fx:id="table_hangHoa" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Danh sách đang để trống. Vui lòng nhập từ khóa hoặc chọn tình trạng rồi bấm 'Tìm kiếm'." style="-fx-text-fill: #7A8CA3; -fx-font-style: italic; -fx-font-size: 13.5px;"/>
                </placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cl_ma" text="Mã hàng" prefWidth="95"/>
                    <TableColumn fx:id="cl_ten" text="Tên hàng hóa" prefWidth="250"/>
                    <TableColumn fx:id="cl_donVi" text="Đơn vị tính" prefWidth="100"/>
                    <TableColumn fx:id="cl_soLuong" text="Số lượng tồn" prefWidth="110"/>
                    <TableColumn fx:id="cl_mucToiThieu" text="Mức tối thiểu" prefWidth="110"/>
                    <TableColumn fx:id="cl_canhBao" text="Tình trạng cảnh báo" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
