<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_QLHangHoa_Controller" prefWidth="980" prefHeight="600">
    <top><HBox styleClass="header" alignment="CENTER_LEFT"><Label text="Quản lý hàng hóa" styleClass="page-title"/></HBox></top>
    <left>
        <GridPane hgap="8" vgap="8" styleClass="center-pane">
            <Label text="Tên hàng hóa*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_ten" prefWidth="220" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Đơn vị tính*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_donVi" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Số lượng tồn*" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_soLuong" prefWidth="220" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Mức tồn tối thiểu*" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_mucToiThieu" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <HBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2">
                <Button text="Thêm" onAction="#them"/>
                <Button text="Cập nhật" onAction="#capNhat"/>
                <Button text="Làm mới" onAction="#lamMoi"/>
            </HBox>
        </GridPane>
    </left>
    <center>
        <VBox spacing="8" styleClass="center-pane">
            <TableView fx:id="table_hangHoa" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cl_ma" text="Mã hàng" prefWidth="110"/>
                    <TableColumn fx:id="cl_ten" text="Tên hàng hóa" prefWidth="260"/>
                    <TableColumn fx:id="cl_donVi" text="Đơn vị tính" prefWidth="120"/>
                    <TableColumn fx:id="cl_soLuong" text="Tồn kho" prefWidth="100"/>
                    <TableColumn fx:id="cl_mucToiThieu" text="Mức tối thiểu" prefWidth="120"/>
                    <TableColumn fx:id="cl_canhBao" text="Tình trạng" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
