<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_BaoCao_Controller" prefWidth="1080" prefHeight="660">
    <top>
        <VBox spacing="8" styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="Báo cáo lượt khám &amp; xuất CSV (UC008)" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lb_thongKeTong" text="Đang tải dữ liệu..." styleClass="hint-text"/>
            </HBox>
            <!-- Thanh lọc theo tiêu chí khoảng thời gian -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #F0F4F8; -fx-padding: 8 12; -fx-background-radius: 8;">
                <Label text="Khoảng thời gian:" style="-fx-font-weight: bold; -fx-text-fill: #173A5E;"/>
                <Label text="Từ:"/>
                <DatePicker fx:id="dp_tuNgay" prefWidth="140"/>
                <Label text="Đến:"/>
                <DatePicker fx:id="dp_denNgay" prefWidth="140"/>
                <Button fx:id="btn_xem" text="Xem thống kê" onAction="#xem" styleClass="btn-primary" defaultButton="true"/>
                <Button fx:id="btn_7Ngay" text="Mặc định (7 ngày)" onAction="#xemMacDinh7Ngay"/>
                <Button fx:id="btn_thangNay" text="Tháng này" onAction="#xemThangNay"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btn_xuatCsv" text="Xuất báo cáo CSV" onAction="#xuatCsv" styleClass="btn-success"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="📊 Diễn biến lượt khám theo ngày">
                <VBox spacing="10" styleClass="center-pane">
                    <BarChart fx:id="chart_luotKham" prefHeight="320" legendVisible="false" animated="false">
                        <xAxis><CategoryAxis label="Ngày khám" animated="false"/></xAxis>
                        <yAxis><NumberAxis label="Số lượt bệnh nhân khám" forceZeroInRange="true"/></yAxis>
                    </BarChart>
                    <TableView fx:id="table_luotKham" VBox.vgrow="ALWAYS" prefHeight="180">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="cl_sttLK" text="STT" prefWidth="60"/>
                            <TableColumn fx:id="cl_ngay" text="Ngày khám" prefWidth="250"/>
                            <TableColumn fx:id="cl_soLuot" text="Số lượt khám" prefWidth="200"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="📈 Tần suất chỉ định dịch vụ">
                <VBox spacing="10" styleClass="center-pane">
                    <BarChart fx:id="chart_dichVu" prefHeight="320" legendVisible="false" animated="false">
                        <xAxis><CategoryAxis label="Dịch vụ" animated="false"/></xAxis>
                        <yAxis><NumberAxis label="Số lượt chỉ định điều trị" forceZeroInRange="true"/></yAxis>
                    </BarChart>
                    <TableView fx:id="table_tanSuat" VBox.vgrow="ALWAYS" prefHeight="180">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="cl_sttTS" text="STT" prefWidth="60"/>
                            <TableColumn fx:id="cl_dv" text="Tên dịch vụ" prefWidth="380"/>
                            <TableColumn fx:id="cl_soLan" text="Số lượt chỉ định" prefWidth="200"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
