<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_QLDichVu_Controller" prefWidth="1050" prefHeight="650">
    <top>
        <VBox spacing="8" styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="Quản lý danh mục dịch vụ (UC007)" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lb_thongKeDichVu" text="Chưa tìm kiếm (Danh sách đang để trống)" styleClass="hint-text"/>
            </HBox>
            <!-- Thanh tra cứu dịch vụ (ẩn danh sách cho đến khi bấm Tìm kiếm) -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #F0F4F8; -fx-padding: 8 12; -fx-background-radius: 8;">
                <Label text="Tra cứu dịch vụ:" style="-fx-font-weight: bold; -fx-text-fill: #173A5E;"/>
                <TextField fx:id="txt_timKiem" promptText="Nhập Tên hoặc Mã dịch vụ..." prefWidth="280"/>
                <Label text="Trạng thái:"/>
                <ComboBox fx:id="cbb_locTrangThai" prefWidth="170"/>
                <Button fx:id="btn_timKiem" text="Tìm kiếm" onAction="#timKiem" styleClass="btn-primary" defaultButton="true"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="12" styleClass="center-pane" prefWidth="360">
            <Label text="THÔNG TIN DỊCH VỤ" styleClass="section-title"/>
            <GridPane hgap="8" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Mã dịch vụ" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_maDichVu" editable="false" promptText="(Tự động cấp mã DVxxxx)" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Tên dịch vụ*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_tenDichVu" promptText="Ví dụ: Cạo vôi răng" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Đơn giá niêm yết*" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_donGia" promptText="VNĐ (Ví dụ: 300000)" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Trạng thái" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbb_trangThai" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Lưới nút hành động 2x2: giải quyết triệt để lỗi co nút mất chữ -->
            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <Button fx:id="btn_them" text="Thêm mới" maxWidth="Infinity" onAction="#them" styleClass="btn-success" style="-fx-padding: 9 8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button fx:id="btn_sua" text="Cập nhật" maxWidth="Infinity" onAction="#sua" styleClass="btn-primary" style="-fx-padding: 9 8;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button fx:id="btn_doiTT" text="Đổi trạng thái" maxWidth="Infinity" onAction="#doiTrangThai" style="-fx-padding: 9 8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button fx:id="btn_lamMoi" text="Làm mới" maxWidth="Infinity" onAction="#lamMoi" style="-fx-padding: 9 8;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="card" spacing="6">
                <Label text="LƯU Ý NGHIỆP VỤ" style="-fx-font-weight: bold; -fx-text-fill: #1D5C8F;"/>
                <Label text="• Khi cập nhật giá dịch vụ, các hóa đơn đã lập trước đó vẫn giữ nguyên đơn giá lịch sử (Snapshot)." wrapText="true" styleClass="hint-text"/>
                <Label text="• Dịch vụ ngừng phục vụ sẽ không xuất hiện trong danh sách chỉ định của bác sĩ." wrapText="true" styleClass="hint-text"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="8" styleClass="center-pane">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="KẾT QUẢ TRA CỨU DỊCH VỤ" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="* Dữ liệu ban đầu được ẩn. Vui lòng bấm Tìm kiếm để xem danh sách." style="-fx-font-style: italic; -fx-text-fill: #7A8CA3;"/>
            </HBox>

            <TableView fx:id="table_dichVu" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Danh sách đang để trống. Vui lòng nhập từ khóa hoặc chọn trạng thái rồi bấm 'Tìm kiếm'." style="-fx-text-fill: #7A8CA3; -fx-font-style: italic; -fx-font-size: 13.5px;"/>
                </placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cl_stt" text="STT" prefWidth="50"/>
                    <TableColumn fx:id="cl_ma" text="Mã DV" prefWidth="95"/>
                    <TableColumn fx:id="cl_ten" text="Tên dịch vụ" prefWidth="280"/>
                    <TableColumn fx:id="cl_gia" text="Đơn giá niêm yết" prefWidth="140"/>
                    <TableColumn fx:id="cl_tt" text="Trạng thái" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
