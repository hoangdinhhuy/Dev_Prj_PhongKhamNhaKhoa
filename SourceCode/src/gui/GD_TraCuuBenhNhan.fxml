<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_TraCuuBenhNhan_Controller" prefWidth="1000" prefHeight="640">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="10">
            <Label text="Tra cứu hồ sơ bệnh nhân" styleClass="page-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" styleClass="center-pane">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ComboBox fx:id="cbb_tieuChi" prefWidth="120"/>
                <TextField fx:id="txt_tuKhoa" prefWidth="320" promptText="Nhập từ khóa"
                           onAction="#tim"/>
                <Button fx:id="btn_tim" text="Tìm" onAction="#tim" defaultButton="true"/>
                <Button text="50 bệnh nhân mới nhất" onAction="#hienTatCa"/>
            </HBox>
            <TableView fx:id="table_ketQua" prefHeight="430" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cl_stt" text="STT" prefWidth="55"/>
                    <TableColumn fx:id="cl_ma" text="Mã BN" prefWidth="115"/>
                    <TableColumn fx:id="cl_hoTen" text="Họ tên" prefWidth="175"/>
                    <TableColumn fx:id="cl_sdt" text="SĐT" prefWidth="110"/>
                    <TableColumn fx:id="cl_cccd" text="CCCD" prefWidth="130"/>
                    <TableColumn fx:id="cl_diaChi" text="Địa chỉ" prefWidth="170"/>
                    <TableColumn fx:id="cl_tienSu" text="Tiền sử dị ứng" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
